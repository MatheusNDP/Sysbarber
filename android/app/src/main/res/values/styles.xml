<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela enquanto o app inicia, até o Flutter desenhar a
         abertura. O app é sempre escuro, com ou sem o modo escuro do Android. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema da janela atrás do Flutter, depois que ele começa a desenhar. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/grafite</item>
    </style>
</resources>
